{
  "name": "mycelia-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "nest build",
    "format": "biome check --write ./src ./test ./scripts ./supabase",
    "openapi:gen": "nestia swagger",
    "start": "pnpm start:api",
    "start:api": "node dist/main.api.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:worker": "node dist/main.worker.js",
    "start:prod": "node scripts/start-prod.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "scan:npm": "npm audit --production --audit-level=high --json",
    "scan:semgrep": "npx semgrep --config p/owasp-top-ten --error",
    "scan:trivy": "trivy fs --scanners vuln,secret,config .",
    "scan:gitleaks": "gitleaks detect -v --source .",
    "scan:all": "npm run scan:npm && npm run scan:semgrep && npm run scan:trivy && npm run scan:gitleaks",
    "validate:env": "node scripts/validate-env.js",
    "validate:usage": "biome lint ./src ./test ./scripts --max-diagnostics=0",
    "types:generate": "supabase gen types --local > src/types/schema.d.ts",
    "types:linked": "supabase gen types --linked > src/types/schema.d.ts",
    "types:clean": "supabase gen types --local --schema public > src/types/schema.d.ts",
    "prepare": "ts-patch install && typia patch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@google-cloud/text-to-speech": "6.4.0",
    "@google/generative-ai": "^0.24.1",
    "@nestia/core": "^9.1.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/feedparser": "^2.2.8",
    "@types/uuid": "^11.0.0",
    "axios": "^1.13.2",
    "bullmq": "^5.66.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "exponential-backoff": "^3.1.3",
    "feedparser": "^2.2.10",
    "file-type": "^21.1.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "ipaddr.js": "^2.3.0",
    "js-yaml": "^4.1.1",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-markdown": "^2.6.7",
    "typeorm": "^0.3.28",
    "typia": "^10.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestia/fetcher": "^9.1.1",
    "@nestia/sdk": "^9.1.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.9",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.4",
    "@types/axios": "^0.14.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.2",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nestia": "^9.1.1",
    "nock": "^14.0.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1",
      "^@test-utils/(.*)$": "<rootDir>/../test/utils/$1"
    }
  },
  "packageManager": "pnpm@10.25.0"
}
